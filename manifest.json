{
  "manifest_version": 3,
  "name": "Datadog Smart Menu",
  "version": "1.2.0",
  "description": "Filters the Datadog interface menu based on each user's role and required permissions",
  "author": "Sébastien BECKER",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.datadoghq.com/*",
    "*://*.datadoghq.eu/*",
    "*://*.ddog-gov.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Datadog Smart Menu"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.datadoghq.com/*",
        "*://*.datadoghq.eu/*",
        "*://*.ddog-gov.com/*"
      ],
      "js": [
        "shared/menu-definitions.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://*.datadoghq.com/*",
        "*://*.datadoghq.eu/*",
        "*://*.ddog-gov.com/*"
      ]
    }
  ]
}